# Marketplace — required in production (Vercel project environment)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
MARKETPLACE_SECRET=generate-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-admin-password

# Public base URL — used to build the tappable link inside job-offer texts
MARKETPLACE_BASE_URL=https://www.freshforlesscarpetcleaning.co.uk

# SMS (Twilio) — the channel that decides who wins first-to-accept jobs.
# Without these, texts are recorded in the admin log but never delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+447700000000

# Email (Resend) — backup channel and customer confirmations
RESEND_API_KEY=
MARKETPLACE_FROM_EMAIL=bookings@freshforlesscarpetcleaning.co.uk

# Vercel cron authentication — the bearer token the three scheduled runs send.
# Without it the invoice, reminder and confirmation endpoints answer anyone who
# finds the URL: a stranger could raise everyone's invoices or text every
# customer.
CRON_SECRET=generate-a-long-random-string

# Square card payments for commission invoices. All three credentials below
# must be set or card payments stay off entirely and cleaners are sent to the
# invoice page and bank transfer exactly as before — a half-set group is
# treated as off on purpose, and the reason is logged.
#
# Without SQUARE_ACCESS_TOKEN no payment link can be created, so every invoice
# falls back to bank transfer.
SQUARE_ACCESS_TOKEN=
# Without SQUARE_LOCATION_ID Square rejects the payment link: a quick-pay link
# must be attached to a location on the account.
SQUARE_LOCATION_ID=
# Without SQUARE_WEBHOOK_SIGNATURE_KEY /api/square/webhook cannot verify that a
# request came from Square, so it refuses every one and card payments would be
# taken but never marked paid.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# sandbox (the default when unset or unrecognised) or production. Wrong way
# round means either test cards against real money or real cards against none,
# so it defaults to the harmless one.
SQUARE_ENV=sandbox
